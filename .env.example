# Day 4 local defaults.
# Copy to `.env` if you want, but never commit `.env`.

EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
BOOKING_PORT=8082
FOOD_PORT=8083
NOTIFICATION_PORT=8084
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka/

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Gateway, Booking, and Food download Auth's public keys from Auth's direct port, not lb://.
STAYFINDER_JWK_SET_URI=http://localhost:8081/api/auth/.well-known/jwks.json

# Host JVM apps. Start broker with: docker compose -f docker-compose.kafka.yml up -d
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
