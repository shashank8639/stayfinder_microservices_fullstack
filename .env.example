# Day 2 local defaults.
# Copy to `.env` if you want, but never commit `.env`.

EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka/

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Gateway downloads Auth's public keys from this URL (Auth's direct port, not lb://).
STAYFINDER_JWK_SET_URI=http://localhost:8081/api/auth/.well-known/jwks.json
