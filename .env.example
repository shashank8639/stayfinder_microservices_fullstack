# Day 5 local defaults.
# Copy to `.env` if you want, but never commit `.env`.

EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
BOOKING_PORT=8082
FOOD_PORT=8083
NOTIFICATION_PORT=8084
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka/

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Compose publishes host 3307 → container 3306 so laptop MySQL can keep 3306.
MYSQL_PUBLISH_PORT=3307

# Gateway, Booking, and Food download Auth's public keys from Auth's direct port, not lb://.
# Compose overrides this to http://auth-service:8081/...
STAYFINDER_JWK_SET_URI=http://localhost:8081/api/auth/.well-known/jwks.json

# Host JVM: docker-compose.kafka.yml → localhost:9092
# Compose stack: kafka:29092 (set in docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
